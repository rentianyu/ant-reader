{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ant-reader",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ant-reader-db",
      "database_id": "8f19a73a-9ea9-418f-9099-89cb733ff3b6"
    }
  ],
  "routes": [
    {
      "pattern": "rss.xbta.cc/*",
      "zone_name": "xbta.cc"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
